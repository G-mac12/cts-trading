# CTS Phase 1 — copy to .env and fill in. .env is git-ignored; never commit it.
#
# Backtest data vendor key. Phase 1 uses CoinAPI (read-only market data by nature).
# Phase 1 needs NO Kraken key. If you ever add one it MUST be read-only/market-data
# (no trade, no withdraw) — the code refuses keys with trade/withdraw scope.
COINAPI_KEY=

# Optional alternate sources (only if you swap the adapter)
CRYPTOCOMPARE_KEY=
