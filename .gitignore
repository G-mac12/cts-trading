# ---- SECRETS: never commit ----
.env
.env.*
!.env.example
*.key
*.pem
secrets/
credentials*.json

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Data ----
# Track the cache SEED (so GitHub Actions can run with no server) and the PAPER
# RECORD (so the forward track persists). Ignore top-level regenerable outputs + logs.
data/*.csv          # top-level only (e.g. universe_log.csv) — regenerable
data/*.json         # top-level only (e.g. analysis.json) — regenerable
data/*.html
data/*.log
data/paper/daily.log
data/paper/*.html
# keep small committed fixtures used by tests
!tests/fixtures/**

# ---- Local-only editor/agent settings ----
.claude/settings.local.json

# ---- OS / editor ----
.DS_Store
.idea/
.vscode/
*.swp
